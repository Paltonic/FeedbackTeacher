rules_version = '2';

// Block ALL direct access from browsers / client SDKs.
// Your Next.js server uses the Admin SDK, which bypasses these rules,
// so the form still works — but nobody can read students' answers
// or write fake data straight to the database.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
